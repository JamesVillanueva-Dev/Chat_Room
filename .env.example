# Copy to .env and adjust. Every value below is optional in development;
# SESSION_SECRET is required when NODE_ENV=production.

NODE_ENV=development

# --- server ---
PORT=3000
HOST=0.0.0.0
# Set to 1 when running behind nginx/Caddy/ngrok so secure cookies and client IPs work.
TRUST_PROXY=0

# --- session ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=30
# Force the Secure cookie flag. Defaults to on in production.
SESSION_SECURE_COOKIES=

# --- database ---
DATABASE_PATH=./data/chat.db

# --- uploads ---
UPLOAD_DIR=./public/uploads
UPLOAD_MAX_BYTES=10485760

# --- chat behaviour ---
HISTORY_PAGE_SIZE=40
MAX_MESSAGE_LENGTH=4000

# --- abuse limits ---
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_MESSAGES=10
RATE_LIMIT_BACKOFF_MS=2000
RATE_LIMIT_BACKOFF_MAX_MS=60000
MAX_CONNECTIONS_PER_IP=12

# --- link unfurling ---
UNFURL_ENABLED=1
UNFURL_TIMEOUT_MS=4000
UNFURL_CACHE_TTL_MINUTES=1440

# --- logging ---
# error | warn | info | debug
LOG_LEVEL=info
# Human-readable logs instead of JSON lines. Defaults to on outside production.
LOG_PRETTY=

# --- rock paper scissors bot ---
RPS_ENABLED=1
PYTHON=python
